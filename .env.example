# Required, the app will not start without these.
SECRET_KEY=change-me-run-python-c-import-secrets-print-secrets-token-urlsafe-32
DATABASE_URL=postgresql://monitor:change-me@db:5432/monitor
REDIS_URL=redis://redis:6379/0

# Read by Compose to initialise Postgres. The password must match DATABASE_URL.

POSTGRES_USER=monitor
POSTGRES_DB=monitor
POSTGRES_PASSWORD=change-me

# Auth. Defaults: HS256, 30 minutes.

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Mail. Defaults target the mailpit container; set SMTP_USER to enable TLS and login.

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=monitoring@localhost

# Logging. LOG_FORMAT=console is easier to read during development.

LOG_LEVEL=INFO
LOG_FORMAT=json

# Behaviour. Defaults shown.

MAX_ENDPOINTS_PER_USER=30
OVERDUE_GRACE_SECONDS=30
RETENTION_DAYS=30
PURGE_BATCH_SIZE=10000

# Leave false in production. Accounts are created with scripts/seed_demo.py.

ALLOW_REGISTRATION=false